{
  "project_name": "DREAM-MILES",
  "identity": {
    "designer": "E1",
    "persona": "The Anti-AI Designer",
    "principles": [
      "Fusion over Imitation: Mix tropical calm with swiss precision.",
      "Emotion First: Every pixel must whisper 'Luxury' and 'Adventure'.",
      "Content is King: The destination is the hero, the UI is the frame.",
      "Zoom In: Use massive, immersive imagery.",
      "Negative Space: Luxury is the absence of clutter."
    ]
  },
  "technical_constraints": {
    "framework": "React",
    "styling": "Tailwind CSS v3 (Use v4-style composition where possible)",
    "icons": "Lucide React (primary), React Icons (for brands/socials)",
    "animation": "Framer Motion (MANDATORY for all interactions)",
    "fonts": "Playfair Display (Headings), DM Sans (Body)"
  },
  "theme_strategy": {
    "mode": "toggle",
    "default": "light",
    "palettes": {
      "light": {
        "name": "Tropical Sand",
        "background": "#FAFAF9", 
        "foreground": "#0C0A09",
        "primary": "#0D9488",
        "secondary": "#FF6B6B",
        "accent": "#FDBA74",
        "card": "#FFFFFF"
      },
      "dark": {
        "name": "Midnight Ocean",
        "background": "#020617",
        "foreground": "#F8FAFC",
        "primary": "#2DD4BF",
        "secondary": "#FB7185",
        "accent": "#FDBA74",
        "card": "#0F172A"
      }
    }
  },
  "typography": {
    "headings": {
      "family": "Playfair Display, serif",
      "weights": ["400", "600", "700"],
      "usage": "Hero titles, Section headers, Country names"
    },
    "body": {
      "family": "DM Sans, sans-serif",
      "weights": ["400", "500", "700"],
      "usage": "Navigation, Descriptions, Buttons, Forms"
    }
  },
  "layout_strategies": {
    "container": "max-w-7xl mx-auto px-6 md:px-12",
    "spacing": "Generous (p-8 to p-32)",
    "grid_system": "Bento Grid (Asymmetric) for Destinations",
    "border_radius": "Rounded-2xl or Rounded-3xl for a soft, premium feel"
  },
  "component_guidelines": {
    "navbar": {
      "style": "Glassmorphism (Backdrop blur-xl, border-b border-white/10)",
      "position": "Fixed top, full width, z-50",
      "elements": "Logo (Serif), Nav Links (uppercase tracking-widest), Theme Toggle, 'Book Now' Pill Button"
    },
    "hero": {
      "style": "Full-screen (h-screen) video/image background",
      "overlay": "Gradient from bottom (black/80 to transparent)",
      "content": "Centered or Bottom-Left aligned. Massive Typography (text-6xl+). Floating Search Bar."
    },
    "destinations_grid": {
      "style": "Bento Grid (Grid-cols-12)",
      "cards": "Image-full, text overlay on hover. Slow zoom animation on hover."
    },
    "hotel_cards": {
      "style": "Clean, minimal, high-aspect ratio images. Price tag floating top-right.",
      "interaction": "Lift on hover (translate-y-2), shadow-xl"
    },
    "booking_form": {
      "style": "Floating glass panel or solid minimal card. Multi-step feel.",
      "inputs": "Underlined or minimal filled backgrounds. No default borders."
    }
  },
